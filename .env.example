# Google Gemini API Key (SERVER SIDE ONLY)
# Get your key from: https://aistudio.google.com/app/apikey
# This key is NOT exposed to the browser. Do NOT prefix with VITE_.
# For Vercel deployment: set this in Vercel Dashboard > Project Settings > Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here

# ----- FOR LOCAL DEVELOPMENT -----
# Install Vercel CLI: npm i -g vercel
# Link your project: vercel link
# Then run: npm run dev:vercel
# This runs both the Vite frontend and serverless API functions together.
